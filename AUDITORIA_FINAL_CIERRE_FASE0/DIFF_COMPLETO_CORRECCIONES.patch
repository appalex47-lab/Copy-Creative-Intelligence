+            if kind == "new": k = "\\ir 00_verificar_marcador.sql\n"; i = s.index(k) + len(k)
+            else: m = re.search(r"do \$v\$ begin if pg_catalog\.to_regclass\('pg_temp\.cci_guarda_ok'\) is null then .*? end \$v\$;\n", s); i = m.end()
