# Copie este archivo a .env.local (NO versionable) solo si necesita cambiar valores.
# NUNCA ponga aquí claves reales. Todo VITE_* queda visible en el navegador.

# Entorno lógico. NORMALMENTE NO SE DEFINE: lo determina el modo de Vite
# (npm run dev -> development, vitest -> test, npm run build -> preview, vite build --mode production -> production).
# Si se define, debe coincidir con el modo; si no, el arranque y el build fallan (configuración contradictoria).
# VITE_APP_ENV=development

# Origen de datos. Hoy solo existe "demo" y solo se permite en development, test y preview.
# Producción rechaza DEMO. "supabase" se rechaza hasta que exista el adaptador (fase futura).
VITE_DATA_MODE=demo

# Reservado para el futuro adaptador Supabase (valores públicos únicamente; la clave anónima es pública por diseño).
# Dejar vacío. NUNCA colocar service_role ni claves de proveedores de IA.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
